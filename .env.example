# =============================================================================
# MedVision AI — environment configuration
# Copy this file to .env and fill in real values before running anything.
# NEVER commit your real .env file to git.
# =============================================================================

# ---- App ----
APP_NAME=MedVision AI
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- Database (MySQL / MariaDB) ----
# Production-style connection string. For local dev without MySQL installed,
# set DATABASE_URL=sqlite:///./medvision_dev.db instead — the app works with both.
DATABASE_URL=mysql+pymysql://medvision:medvision_dev_pass@localhost:3306/medvision_ai

# ---- Redis (cache + Celery broker/result backend) ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- JWT auth ----
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET_KEY=CHANGE_ME_to_a_different_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Gemini API (Google AI Studio) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# If no key is set, the LLM layer automatically falls back to a deterministic
# template response built directly from retrieved knowledge-base context —
# the app keeps working end-to-end, just without natural-language polish.

# ---- RAG / vector index ----
FAISS_INDEX_DIR=./app/ml_artifacts/faiss_index
EMBEDDING_BACKEND=tfidf          # tfidf (offline, default) | gemini (requires API key + internet)

# ---- File storage ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# ---- Vision "demo" model ----
VISION_MODEL_PATH=./app/ml_artifacts/vision_demo_model.joblib

# ---- Maps (Yandex) ----
# Get a key at https://developer.tech.yandex.com
YANDEX_API_KEY=

# ---- Email (for verification / password reset — optional in dev) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@medvision.ai

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=60

# ---- Additional configs ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FREE_TIER_DAILY_CHAT_LIMIT=15
SMTP_USE_TLS=True
